# Copy to .env and fill in from Supabase Dashboard > Settings > API Keys

# Public, used by the browser (also set these on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret, only for `npm run sync-defaults` on your machine. Never prefix with NEXT_PUBLIC_ or set on Vercel
SUPABASE_SECRET_KEY=sb_secret_...
